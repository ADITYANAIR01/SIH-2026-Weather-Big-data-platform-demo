# Run resolution: public map defaults to bundled mock data; set "live" to consume the real backend.
NEXT_PUBLIC_DATA_MODE=mock

# Backend base used by the Next.js server-side proxy (/api/backend/*). INTERNAL docker name:
# http://api:8000  (when frontend runs inside compose "web" service)
BACKEND_BASE_URL=http://localhost:8000
ADMIN_TOKEN=sih2026-demo-admin-token